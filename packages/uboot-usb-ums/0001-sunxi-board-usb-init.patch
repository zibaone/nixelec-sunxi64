+#if defined(CONFIG_USB_MUSB_GADGET) && !CONFIG_IS_ENABLED(DM_USB_GADGET)
+/*
+ * U-Boot n'a pas de chemin DM pour le gadget MUSB : musb_gadget.c ne
+ * s'enregistre aupres du cadre UDC que hors U-Boot (#ifndef __UBOOT__). La
+ * commande `ums` passe donc par le chemin legacy, qui appelle
+ * board_usb_init() — defini __weak a `return 0' dans common/usb.c. Sans cette
+ * implementation, `ums' repond « Controller uninitialized » puis
+ * « g_dnl_register: failed!, error: -6 » (mesure sur H96 Max H618).
+ *
+ * Sonder l'udevice suffit : musb_usb_probe() s'occupe de l'horloge, du reset,
+ * de la PHY, puis appelle musb_register() en mode peripherique.
+ */
+int board_usb_init(int index, enum usb_init_type init)
+{
+	struct udevice *dev;
+	int ret;
+
+	if (init != USB_INIT_DEVICE)
+		return 0;
+
+	ret = uclass_get_device(UCLASS_USB_GADGET_GENERIC, index, &dev);
+	if (ret) {
+		printf("sunxi: pas de controleur USB gadget (%d)\n", ret);
+		return ret;
+	}
+
+	return 0;
+}
+#endif
+
