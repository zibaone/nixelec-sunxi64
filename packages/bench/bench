#!/usr/bin/env bash
# bench — banc d'essai sunxi64 : inventaire de la carte, noyau de test, retour
# au boot normal.
#
# Mesuré sur Transpeed 8K618-T (U-Boot 2025.04) : le chargeur ne scanne PAS p1.
# Il lit `mmc 1:2:/boot/extlinux/extlinux.conf` — la configuration de banc vit
# donc sur p2, à côté de celle de NixOS. Les charges utiles (Image, DTB, initrd)
# vont dans /boot/test/ : elles ne sont pas gérées par NixOS et survivent aux
# activations.
#
# `bench boot-test` ajoute une entrée `bench` au fichier généré par NixOS et
# passe `DEFAULT` dessus, après avoir sauvegardé l'original. Toute activation
# NixOS réécrit ce fichier et remet donc le boot normal : le banc ne peut pas
# rester armé par accident.
set -euo pipefail

BOOT="${BENCH_BOOT:-/boot}"
CONF="${BOOT}/extlinux/extlinux.conf"
BACKUP="${CONF}.pre-bench"
DEST="${BOOT}/test"

usage() {
    cat <<'EOF'
bench — banc d'essai sunxi64

  bench inventory [--json]              inventaire lecture seule de la carte
  bench boot-test <Image> <dtb> <initrd> [--append "k=v …"]
                                        installe un noyau de test et l'arme
                                        pour le prochain démarrage
  bench clear                           retire l'entrée et les fichiers de test
  bench status                          ce que le prochain boot fera

Variables : BENCH_BOOT (défaut /boot)
EOF
}

die() { echo "bench: $*" >&2; exit 1; }

default_label() {
    awk '/^DEFAULT[[:space:]]/ {print $2; exit}' "$CONF" 2>/dev/null || true
}

running_append() {
    [ -r "$CONF" ] || die "$CONF illisible : lancer bench depuis le système installé"
    awk '/^[[:space:]]*APPEND[[:space:]]/ {sub(/^[[:space:]]*APPEND[[:space:]]+/, ""); print; exit}' "$CONF"
}

cmd_status() {
    local def
    def=$(default_label)
    if [ "$def" = "bench" ]; then
        echo "banc ARMÉ : prochain boot = noyau de test"
    else
        echo "banc inactif : prochain boot = système NixOS (DEFAULT=${def:-absent})"
    fi
    if [ -d "$DEST" ]; then
        echo -n "  fichiers : "
        printf '%s ' "$DEST"/*
        echo
    fi
    [ -f "$BACKUP" ] && echo "  sauvegarde : $BACKUP"
}

cmd_inventory() {
    local model kernel loader p1dev disk sig
    if [ -r /proc/device-tree/model ]; then
        model=$(tr -d '\0' < /proc/device-tree/model)
    else
        model=inconnu
    fi
    kernel=$(uname -r)

    # Le SPL est à 8 Kio du DISQUE, avant la table de partitions : lire une
    # partition ne trouverait jamais eGON.
    loader="absent"
    p1dev=$(blkid -L FIRMWARE 2>/dev/null || true)
    if [ -n "$p1dev" ]; then
        disk=$(lsblk -npo PKNAME "$p1dev" 2>/dev/null || true)
        [ -n "$disk" ] || disk=$p1dev
        sig=$(od -An -tx1 -j 8196 -N 4 "$disk" 2>/dev/null | tr -s ' ' || true)
        [ "$(echo "$sig" | tr -d ' ')" = "65474f4e" ] && loader="eGON (offset 8196, $disk)"
    fi

    if [ "${1:-}" = "--json" ]; then
        local active=false
        [ "$(default_label)" = bench ] && active=true
        printf '{"machine":"%s","kernel":"%s","loader":"%s","benchActive":%s,"disks":%s}\n' \
            "${model//\"/\\\"}" "$kernel" "$loader" "$active" \
            "$(lsblk --json -o NAME,SIZE,MODEL,LABEL,FSTYPE,TYPE 2>/dev/null || echo '{}')"
    else
        echo "machine : $model"
        echo "noyau   : $kernel"
        echo "chargeur: $loader"
        if [ "$(default_label)" = bench ]; then
            echo "banc    : armé"
        else
            echo "banc    : inactif"
        fi
        echo
        lsblk -o NAME,SIZE,MODEL,LABEL,FSTYPE,MOUNTPOINTS
    fi
}

cmd_boot_test() {
    [ $# -ge 3 ] || { usage; exit 1; }
    local img=$1 dtb=$2 initrd=$3
    shift 3
    local extra="" append dtbname
    while [ $# -gt 0 ]; do
        case $1 in
            --append) extra=${2:-}; shift 2 ;;
            *) die "option inconnue : $1" ;;
        esac
    done
    for f in "$img" "$dtb" "$initrd"; do [ -r "$f" ] || die "fichier illisible : $f"; done

    append=$(running_append)
    [ -n "$append" ] || die "ligne APPEND vide : refus d'écrire un menu incohérent"

    # Sauvegarde unique : la base reste la configuration NixOS d'origine, même
    # si on arme le banc plusieurs fois de suite.
    [ -f "$BACKUP" ] || cp -- "$CONF" "$BACKUP"

    dtbname=$(basename "$dtb")
    mkdir -p "$DEST"
    cp -- "$img" "$DEST/Image"
    cp -- "$dtb" "$DEST/$dtbname"
    cp -- "$initrd" "$DEST/initrd"

    # Repartir de la sauvegarde évite d'empiler les entrées bench.
    cp -- "$BACKUP" "$CONF"
    sed -i 's/^DEFAULT[[:space:]].*/DEFAULT bench/' "$CONF"
    {
        echo
        echo "LABEL bench"
        echo "    MENU LABEL noyau de test"
        # Chemins absolus depuis la RACINE de la partition : /boot est un
        # répertoire de p2, donc le fichier est /boot/test/..., pas /test/...
        # Mesuré : /test/Image donne « File not found » puis repli sur l'entrée
        # NixOS par défaut.
        echo "    LINUX /boot/test/Image"
        echo "    FDT /boot/test/$dtbname"
        echo "    INITRD /boot/test/initrd"
        echo "    APPEND $append $extra"
    } >> "$CONF"
    sync

    echo "banc armé : $CONF (DEFAULT bench)"
    echo "  $(stat -c%s "$DEST/Image") o Image, $(stat -c%s "$DEST/initrd") o initrd, DTB $dtbname"
    echo "  append : $append $extra"
    echo "rebooter ; 'bench clear' pour revenir au boot NixOS."
}

cmd_clear() {
    if [ -f "$BACKUP" ]; then
        cp -- "$BACKUP" "$CONF"
        rm -f "$BACKUP"
    fi
    rm -rf "$DEST"
    sync
    echo "banc retiré : prochain boot = système NixOS"
}

case ${1:-} in
    inventory) shift; cmd_inventory "$@" ;;
    boot-test) shift; cmd_boot_test "$@" ;;
    clear)     shift; cmd_clear "$@" ;;
    status)    shift; cmd_status "$@" ;;
    -h|--help|"") usage ;;
    *) die "commande inconnue : $1 (voir --help)" ;;
esac
