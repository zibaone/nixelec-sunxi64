--- a/drivers/clk/sunxi-ng/ccu-sun50i-h616.c
+++ b/drivers/clk/sunxi-ng/ccu-sun50i-h616.c
@@ -489,8 +489,23 @@
 static SUNXI_CCU_GATE(bus_spi0_clk, "bus-spi0", "ahb3", 0x96c, BIT(0), 0);
 static SUNXI_CCU_GATE(bus_spi1_clk, "bus-spi1", "ahb3", 0x96c, BIT(1), 0);
 
-static SUNXI_CCU_GATE(emac_25m_clk, "emac-25m", "ahb3", 0x970,
-		      BIT(31) | BIT(30), 0);
+/*
+ * Le BSP Allwinner regle au meme endroit un diviseur (bits 29:28) que le
+ * mainline ne modelisait pas: la PHY EPHY AC300 etait horlogee a 200 MHz
+ * (ahb3 brut) au lieu de 25, ce qui casse la recuperation de rythme en
+ * reception (petites trames OK, trames longues corrompues).
+ */
+static const struct clk_div_table emac_25m_div_table[] = {
+	{ .val = 0, .div = 1 },
+	{ .val = 1, .div = 2 },
+	{ .val = 2, .div = 4 },
+	{ .val = 3, .div = 8 },
+	{ /* sentinel */ }
+};
+
+static SUNXI_CCU_DIV_TABLE_WITH_GATE(emac_25m_clk, "emac-25m", "ahb3", 0x970,
+				     28, 2, emac_25m_div_table,
+				     BIT(31) | BIT(30), 0);
 
 static SUNXI_CCU_GATE(bus_emac0_clk, "bus-emac0", "ahb3", 0x97c, BIT(0), 0);
 static SUNXI_CCU_GATE(bus_emac1_clk, "bus-emac1", "ahb3", 0x97c, BIT(1), 0);
