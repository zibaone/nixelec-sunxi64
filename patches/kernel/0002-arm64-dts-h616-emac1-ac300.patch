--- a/arch/arm64/boot/dts/allwinner/sun50i-h618-transpeed-8k618-t.dts	2026-11-05 15:27:29.679924206 +0100
+++ b/arch/arm64/boot/dts/allwinner/sun50i-h618-transpeed-8k618-t.dts	2026-11-05 15:27:29.680032188 +0100
@@ -224,3 +224,39 @@
 &usbphy {
 	status = "okay";
 };
+
+/* Ethernet : le RJ45 est sur EMAC1, relie au PHY AC200/AC300 co-packaged.
+ * Le noeud du dtsi est la forme vendor `sunxi-gmac` (qu'aucun driver mainline
+ * ne pilote) : on le reprend ici, sans toucher au dtsi partage, pour ne pas
+ * modifier l'Ethernet des autres cartes H616.
+ */
+&emac1 {
+	compatible = "allwinner,sun50i-h616-emac";
+	syscon = <&syscon 1>;
+	reg = <0x05030000 0x10000>;
+	reg-names = "gmac1_reg";
+	interrupts = <GIC_SPI 15 IRQ_TYPE_LEVEL_HIGH>;
+	interrupt-names = "macirq";
+	resets = <&ccu RST_BUS_EMAC1>;
+	reset-names = "stmmaceth";
+	clocks = <&ccu CLK_BUS_EMAC1>;
+	clock-names = "stmmaceth";
+	pinctrl-names = "default";
+	pinctrl-0 = <&rmii_pins>;
+	phy-mode = "rmii";
+	phy-handle = <&ephy1>;
+	status = "okay";
+};
+
+&mdio1 {
+	compatible = "snps,dwmac-mdio";
+
+	ephy1: ethernet-phy@0 {
+		compatible = "ethernet-phy-id0044.1400",
+			     "allwinner,sun50i-h618-ac300-ephy",
+			     "ethernet-phy-ieee802.3-c22";
+		reg = <0x0>;
+		clocks = <&ccu CLK_EMAC_25M>;
+		clock-names = "ephy";
+	};
+};
