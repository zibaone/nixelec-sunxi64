From: zibao <zibao@proton.me>
Subject: [PATCH] watchdog: sunxi: stop the counter from a PM notifier

The sunxi watchdog counter is clocked from the always-on domain: it keeps
counting while the system is in s2idle, while the only task pinging it is
userspace, which is frozen for the whole sleep.  The board is therefore
reset in the middle of the sleep instead of resuming it.

The counter is stopped/restarted from a driver PM notifier rather than
from ->suspend()/->resume(): on a H96 Max H618 (H618, 16 s timeout,
s2idle) stopping it from ->suspend() was measured to break the RTC alarm
wake-up, while stopping it before the dpm phase resumed cleanly.

WDOG_NO_PING_ON_SUSPEND must be set before watchdog registration, so the
core registers its own PM notifier: it pings once and cancels the
keepalive/pretimeout hrtimer.  A first version set the bit after
registration; the core notifier was never registered and the pretimeout
hrtimer panicked the kernel in the middle of s2idle ("watchdog pretimeout
event").

Signed-off-by: zibao <zibao@proton.me>

--- a/drivers/watchdog/sunxi_wdt.c
+++ b/drivers/watchdog/sunxi_wdt.c
@@ -19,6 +19,7 @@
 #include <linux/moduleparam.h>
 #include <linux/of.h>
 #include <linux/platform_device.h>
+#include <linux/suspend.h>
 #include <linux/types.h>
 #include <linux/watchdog.h>
 
@@ -54,6 +55,7 @@
 	struct watchdog_device wdt_dev;
 	void __iomem *wdt_base;
 	const struct sunxi_wdt_reg *wdt_regs;
+	struct notifier_block pm_notifier;
 };
 
 /*
@@ -192,6 +194,31 @@
 	return 0;
 }
 
+static void sunxi_wdt_pm_unregister(void *data)
+{
+	unregister_pm_notifier(data);
+}
+
+static int sunxi_wdt_pm_notify(struct notifier_block *nb, unsigned long event,
+			       void *unused)
+{
+	struct sunxi_wdt_dev *sunxi_wdt = container_of(nb, struct sunxi_wdt_dev,
+						       pm_notifier);
+
+	switch (event) {
+	case PM_SUSPEND_PREPARE:
+		if (watchdog_active(&sunxi_wdt->wdt_dev))
+			sunxi_wdt_stop(&sunxi_wdt->wdt_dev);
+		break;
+	case PM_POST_SUSPEND:
+		if (watchdog_active(&sunxi_wdt->wdt_dev))
+			sunxi_wdt_start(&sunxi_wdt->wdt_dev);
+		break;
+	}
+
+	return NOTIFY_DONE;
+}
+
 static const struct watchdog_info sunxi_wdt_info = {
 	.identity	= DRV_NAME,
 	.options	= WDIOF_SETTIMEOUT |
@@ -286,6 +313,17 @@
 
 	watchdog_set_drvdata(&sunxi_wdt->wdt_dev, sunxi_wdt);
 
+	/*
+	 * The counter is clocked from the always-on domain and cannot be
+	 * serviced while the system is suspended.  The bit must be set
+	 * before watchdog registration: the core registers its PM notifier
+	 * (which pings once and cancels the keepalive/pretimeout hrtimer)
+	 * only when it is set at that point.  The driver notifier stops the
+	 * counter before the dpm phase; stopping it from ->suspend() was
+	 * measured to break the RTC alarm wake-up on s2idle (H96 Max H618).
+	 */
+	set_bit(WDOG_NO_PING_ON_SUSPEND, &sunxi_wdt->wdt_dev.status);
+
 	sunxi_wdt_stop(&sunxi_wdt->wdt_dev);
 
 	watchdog_stop_on_reboot(&sunxi_wdt->wdt_dev);
@@ -293,6 +331,15 @@
 	if (unlikely(err))
 		return err;
 
+	sunxi_wdt->pm_notifier.notifier_call = sunxi_wdt_pm_notify;
+	err = register_pm_notifier(&sunxi_wdt->pm_notifier);
+	if (err)
+		return err;
+	err = devm_add_action_or_reset(dev, sunxi_wdt_pm_unregister,
+				       &sunxi_wdt->pm_notifier);
+	if (err)
+		return err;
+
 	dev_info(dev, "Watchdog enabled (timeout=%d sec, nowayout=%d)",
 		 sunxi_wdt->wdt_dev.timeout, nowayout);
 
